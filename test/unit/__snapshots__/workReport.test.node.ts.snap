// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`workReport host helpers buildWorkReportQuery produces a snapshot-stable query for multiple hosts 1`] = `
"
            window_raw_0 = query_bucket("aw-watcher-window_laptop", 1001);
            window_source_count_0 = event_count(window_raw_0);
            window_raw_0 = limit_events(window_raw_0, 1000);
            window_raw_0 = sort_by_timestamp(window_raw_0);
            events_0 = flood(window_raw_0);
            afk_raw_0 = query_bucket("aw-watcher-afk_laptop", 1001);
            afk_source_count_0 = event_count(afk_raw_0);
            afk_raw_0 = limit_events(afk_raw_0, 1000);
            afk_raw_0 = sort_by_timestamp(afk_raw_0);
            not_afk_0 = flood(afk_raw_0);
            not_afk_0 = filter_keyvals(not_afk_0, "status", ["not-afk"]);
            events_0 = filter_period_intersect(events_0, not_afk_0);

            window_raw_1 = query_bucket("aw-watcher-window_desktop", 1001);
            window_source_count_1 = event_count(window_raw_1);
            window_raw_1 = limit_events(window_raw_1, 1000);
            window_raw_1 = sort_by_timestamp(window_raw_1);
            events_1 = flood(window_raw_1);
            afk_raw_1 = query_bucket("aw-watcher-afk_desktop", 1001);
            afk_source_count_1 = event_count(afk_raw_1);
            afk_raw_1 = limit_events(afk_raw_1, 1000);
            afk_raw_1 = sort_by_timestamp(afk_raw_1);
            not_afk_1 = flood(afk_raw_1);
            not_afk_1 = filter_keyvals(not_afk_1, "status", ["not-afk"]);
            events_1 = filter_period_intersect(events_1, not_afk_1);

events = [];
events = union_no_overlap(events, events_0);
events = union_no_overlap(events, events_1);
          events = sort_by_timestamp(events);
          report_event_count = event_count(events);
          events = limit_events(events, 2000);
          events = categorize(events, []);
          events = filter_keyvals(events, "$category", [["Work"]]);
          duration = sum_durations(events);
          source_event_counts = [window_source_count_0, afk_source_count_0, window_source_count_1, afk_source_count_1];
          RETURN = {"events": events, "duration": duration, "source_event_counts": source_event_counts, "report_event_count": report_event_count};
"
`;
